<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="controller.ContactsContentController" spacing="0">

    <!-- Contact List -->
    <VBox spacing="0" style="-fx-min-width: 280; -fx-max-width: 300; -fx-background-color: white; -fx-border-color: transparent #E0E5F2 transparent transparent;">
        <padding><Insets top="12"/></padding>
        <HBox spacing="8" style="-fx-padding: 0 16 12 16;">
            <TextField promptText="Search contacts..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
        </HBox>
        <Separator/>
        <Label text="ONLINE" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #48BB78; -fx-padding: 8 16 4 16;"/>
        <VBox fx:id="onlineContacts" spacing="0"/>
        <Separator/>
        <Label text="ALL CONTACTS" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #8F9BBA; -fx-padding: 8 16 4 16;"/>
        <VBox fx:id="allContacts" spacing="0"/>
    </VBox>

    <!-- Chat Area -->
    <VBox spacing="0" HBox.hgrow="ALWAYS">
        <!-- Chat Header -->
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 12 24; -fx-border-color: transparent transparent #E0E5F2 transparent;">
            <StackPane style="-fx-background-color: #4361EE; -fx-background-radius: 50; -fx-min-width: 36; -fx-min-height: 36; -fx-max-width: 36; -fx-max-height: 36;">
                <Label text="BH" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;"/>
            </StackPane>
            <VBox>
                <Label fx:id="chatName" text="Bensaid Hadjer" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2B3674;"/>
                <Label text="Online" style="-fx-font-size: 11; -fx-text-fill: #48BB78;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="\uD83D\uDDE3" styleClass="icon-btn"/>
        </HBox>

        <!-- Messages -->
        <VBox fx:id="messageArea" spacing="8" VBox.vgrow="ALWAYS">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
        </VBox>

        <!-- Input -->
        <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 12 24; -fx-border-color: #E0E5F2 transparent transparent transparent;">
            <TextField fx:id="messageInput" promptText="Type a message..." styleClass="auth-field" HBox.hgrow="ALWAYS"/>
            <Button text="\u27A4" onAction="#sendMessage"
                    style="-fx-background-color: #4361EE; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40; -fx-cursor: hand; -fx-font-size: 16;"/>
        </HBox>
    </VBox>
</HBox>
