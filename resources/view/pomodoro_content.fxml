<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="controller.PomodoroContentController" spacing="24">
    <!-- Left Panel -->
    <VBox spacing="16" HBox.hgrow="ALWAYS">

        <!-- Timer Card -->
        <VBox styleClass="card" spacing="16" alignment="CENTER" style="-fx-background-color: #2B3674; -fx-background-radius: 20;">
            <padding><Insets top="32" bottom="32"/></padding>
            <Label fx:id="timerLabel" text="25:00" style="-fx-font-size: 64; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="modeLabel" text="Focus Session" style="-fx-font-size: 16; -fx-text-fill: rgba(255,255,255,0.7);"/>
            <HBox spacing="16" alignment="CENTER">
                <Button fx:id="startBtn" text="\u25B6  Start" onAction="#handleStartPause"
                        style="-fx-background-color: #4361EE; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 12 32; -fx-background-radius: 14; -fx-cursor: hand;"/>
                <Button text="\u21BA  Reset" onAction="#handleReset"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 10 24; -fx-background-radius: 14; -fx-cursor: hand;"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER">
                <Button text="25 min" styleClass="pomo-time-btn" onAction="#setFocus25"/>
                <Button text="5 min" styleClass="pomo-time-btn" onAction="#setBreak5"/>
                <Button text="15 min" styleClass="pomo-time-btn" onAction="#setBreak15"/>
                <Button text="50 min" styleClass="pomo-time-btn" onAction="#setFocus50"/>
            </HBox>
        </VBox>

        <!-- Sessions Table -->
        <VBox styleClass="card" spacing="12">
            <Label text="Today's sessions" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2B3674;"/>
            <VBox fx:id="sessionList" spacing="6"/>
        </VBox>
    </VBox>

    <!-- Right Panel -->
    <VBox spacing="16" style="-fx-min-width: 280; -fx-max-width: 300;">

        <!-- Tasks -->
        <VBox styleClass="card" spacing="8">
            <HBox alignment="CENTER_LEFT">
                <Label text="Tasks" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2B3674;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+" onAction="#addTask" style="-fx-background-color: #4361EE; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 28; -fx-min-height: 28; -fx-font-size: 14; -fx-cursor: hand;"/>
            </HBox>
            <VBox fx:id="taskList" spacing="6"/>
        </VBox>

        <!-- Streak -->
        <VBox styleClass="card" spacing="8" alignment="CENTER">
            <Label text="\uD83D\uDD25" style="-fx-font-size: 32;"/>
            <Label text="7 Day Streak" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2B3674;"/>
            <Label text="Keep it going!" style="-fx-font-size: 12; -fx-text-fill: #8F9BBA;"/>
            <HBox fx:id="streakDots" spacing="6" alignment="CENTER"/>
        </VBox>

        <!-- Stats -->
        <VBox styleClass="card" spacing="12">
            <Label text="This week" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2B3674;"/>
            <HBox spacing="12">
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #E8ECF8; -fx-background-radius: 12; -fx-padding: 12;">
                    <Label text="6" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #4361EE;"/>
                    <Label text="Sessions" style="-fx-font-size: 11; -fx-text-fill: #8F9BBA;"/>
                </VBox>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #F3E8FF; -fx-background-radius: 12; -fx-padding: 12;">
                    <Label text="2h 30m" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #7C5CFC;"/>
                    <Label text="Focus time" style="-fx-font-size: 11; -fx-text-fill: #8F9BBA;"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</HBox>
